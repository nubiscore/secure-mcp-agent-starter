# ---- MCP server (resource server) ----
PORT=3001
# Bind address. Keep 0.0.0.0 in containers; use 127.0.0.1 behind an SSH tunnel.
HOST=0.0.0.0
# Canonical URI of THIS server. Tokens must carry it in `aud`. Use the public HTTPS URL in production.
MCP_CANONICAL_URI=http://localhost:3001

# ---- Authorization server (your IdP) ----
# Local dev: the stub issuer in dev/issuer.ts. Production: Keycloak, Entra ID, Okta, Auth0, etc.
OAUTH_ISSUER=http://localhost:3000
OAUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json

# ---- Tool manifest ----
TOOL_MANIFEST=./tools/manifest.yaml
# Pin the manifest hash printed at startup. If set and the loaded manifest differs, the server refuses to start.
# MANIFEST_HASH_PIN=sha256:...

# ---- Kill switch ----
# JSON file re-read on EVERY tool call. In Kubernetes, mount it from a ConfigMap so on-call can flip it without a deploy.
KILL_SWITCH_FILE=./dev/kill-switch.json

# ---- Containment budgets (per MCP session) ----
BUDGET_MAX_ITERATIONS=8
BUDGET_MAX_TOOL_CALLS=20
BUDGET_MAX_TOKENS=120000
BUDGET_MAX_MUTATIONS=3
