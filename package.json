{
  "name": "secure-mcp-agent-starter",
  "version": "0.1.0",
  "description": "Reference implementation of a production-hardened MCP server and agent loop: OAuth 2.1 resource server, purpose-bound tools, containment, and audit trail.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:issuer": "tsx dev/issuer.ts",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "tsx examples/client.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "manifest:hash": "tsx -e \"import('./src/tools/manifest.ts').then(m => console.log(m.hashManifest(m.loadManifest(process.env.TOOL_MANIFEST ?? 'tools/manifest.yaml'))))\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "yaml": "2.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "eslint": "9.39.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vitest": "5.0.1"
  }
}
